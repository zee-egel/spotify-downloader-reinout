FROM node:22-bookworm-slim AS node
FROM slskd/slskd:0.26.0

USER root
RUN apt-get update && apt-get install --no-install-recommends -y python3 python3-venv ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir 'yt-dlp[default]'
COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /opt/playlist-desk
COPY app.py profiles.py views.py ui.css ui.js profile.js youtube_fallback.py download_doctor.py ./
COPY templates ./templates
COPY railway-start.sh ./
RUN /opt/venv/bin/python -c "from importlib.metadata import version; print(version('yt-dlp'), version('yt-dlp-ejs'))" \
    && node --version && ffprobe -version \
    && chmod +x railway-start.sh
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    STATE_FILE=/data/state/runs.json \
    DOWNLOADS_ROOT=/data/downloads \
    SLSKD_APP_DIR=/data/slskd \
    APP_DIR=/data/slskd \
    SLSKD_DOWNLOADS_DIR=/data/downloads \
    SLSKD_INCOMPLETE_DIR=/data/incomplete \
    SLSKD_URL=http://127.0.0.1:5030 \
    SLSKD_NO_HTTPS=true \
    PORT=8080
EXPOSE 8080 5030 50300
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/playlist-desk/railway-start.sh"]
CMD []
