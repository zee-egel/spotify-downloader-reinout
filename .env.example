# Copy to .env and keep it private.
APP_USER=admin
APP_PASSWORD=
# Optional second account (no registration flow).
EXTRA_APP_USER=
EXTRA_APP_PASSWORD=
APP_PUBLIC_URL=https://dj.reinout.dance
# One Spotify developer app; each user connects their own Spotify account.
SPOTIFY_CLIENT_ID=
# Optional proxy for YouTube recovery on hosts rejected by YouTube.
YOUTUBE_PROXY=
# Railway only: use the Pi as a private YouTube proxy through Tailscale.
YOUTUBE_EXIT_NODE=
TS_AUTHKEY=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
COMPLETED_DOWNLOADS_HOST_PATH=/home/admin/slskd/downloads
SLSKD_DOCKER_NETWORK=n8n_default
